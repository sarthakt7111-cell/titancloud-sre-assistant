# TitanCloud SRE Incident Assistant Configuration

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# RAG & Embedding Configuration
# Embedding model name (SentenceTransformers default: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db
# SQLite database path
DATABASE_URL=sqlite:///./titancloud.db

# RAG Hyperparameters
RAG_TOP_K=4
CHUNK_SIZE=850
CHUNK_OVERLAP=150
